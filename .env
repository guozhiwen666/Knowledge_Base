# ====================
# Vector Database (Milvus)
# ====================
MILVUS_URL=http://192.168.10.10:19530
# 知识库切片集合名（需与 backend/models/vector.py 的 COLLECTION_NAME 保持一致）
CHUNKS_COLLECTION=kb_unit_chunks

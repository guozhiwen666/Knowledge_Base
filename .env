TEXT_EMBEDDING_MODEL=text-embedding-v4
TEXT_EMBEDDING_BATCH_SIZE=10

# ====================
# 本项目：数据库与认证
# ====================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=knowledge_base
DB_CHARSET=utf8mb4
STORAGE_ROOT_DIR=storage
JWT_EXPIRE_MINUTES=120
JWT_SECRET_KEY=01afb70f3cd0c2afe11c4c58447fa4b7576f9a38c427acc0fbc2411d3c8a6886

# ====================
# 本项目：Redis（FAQ 缓存 / 看板实时计数 / 会话 / 登录限流 / 令牌黑名单）
# Redis 未启动时程序会自动降级为进程内缓存，但登录限流与令牌吊销将不可用
# ====================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ====================
# 本项目：应用监听地址与安全
# ====================
APP_HOST=127.0.0.1
APP_PORT=8000
# CORS 允许的前端来源（逗号分隔）。生产务必锁定前端域名；留空回退 "*"
CORS_ALLOW_ORIGINS=
# 召回相似度阈值：实测命中约 0.73~0.79，必须低于默认 0.8，否则召回全空
RECALL_SIMILARITY_THRESHOLD=0.7
# 登录限流：窗口内失败上限
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_WINDOW_SECONDS=300

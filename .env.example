# =============================================================================
# 知识库管理平台 · 环境变量模板（复制为 .env 后填入真实值）
#
# 说明：
#   * 本文件不含任何真实密钥，部署前 cp .env.example .env 并逐项替换占位符。
#   * 所有变量由 backend/core/config.py 读取；改环境只改这里，不用动代码。
#   * .env 必须加入 .gitignore（已配置），切勿提交真实密钥。
# =============================================================================

# -------------------- 应用 --------------------
# 监听地址：容器/反向代理场景下填 0.0.0.0；被 nginx 反代时填 127.0.0.1 即可
APP_HOST=0.0.0.0
APP_PORT=8000

# CORS 允许的前端来源（逗号分隔）。生产务必锁定为前端域名，例如：
#   CORS_ALLOW_ORIGINS=https://kb.example.com
# 留空则回退为 "*"（任意来源可调用 API，仅限本地/演示）
CORS_ALLOW_ORIGINS=

# -------------------- MySQL（10 张业务表）--------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=<CHANGE-ME>
DB_NAME=knowledge_base
DB_CHARSET=utf8mb4

# -------------------- JWT（令牌签发）--------------------
# 务必使用强随机值（如：openssl rand -hex 32），且不要与开发环境共用
JWT_SECRET_KEY=<CHANGE-ME-32BYTES-HEX>
JWT_EXPIRE_MINUTES=120

# -------------------- Milvus（向量集合）--------------------
MILVUS_URL=http://127.0.0.1:19530
CHUNKS_COLLECTION=kb_unit_chunks
TEXT_EMBEDDING_DIMENSION=1024

# -------------------- MinIO（原始文件）--------------------
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=<CHANGE-ME>
MINIO_SECRET_KEY=<CHANGE-ME>
MINIO_BUCKET_NAME=knowledge-base
MINIO_SECURE=false

# -------------------- Redis（FAQ 缓存 / 实时计数 / 会话 / 限流 / 令牌黑名单）--------------------
# 生产必须启用 Redis：登录限流与令牌吊销（登出）依赖它；缺失时这些能力降级不可用。
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# -------------------- LLM（流式回答）--------------------
# OpenAI 兼容模式网关（本项目用阿里云百炼兼容端点）
OPENAI_BASE_URL=https://<your-compatible-gateway>/compatible-mode/v1
OPENAI_API_KEY=<CHANGE-ME>
LLM_DEFAULT_MODEL=qwen-flash
LLM_DEFAULT_TEMPERATURE=0.1

# -------------------- Embedding（向量化）--------------------
# 留空则复用 OPENAI_API_KEY；若用独立密钥再设
TEXT_EMBEDDING_API_KEY=
TEXT_EMBEDDING_MODEL=text-embedding-v4
TEXT_EMBEDDING_BATCH_SIZE=10

# -------------------- 本地存储兜底目录 --------------------
STORAGE_ROOT_DIR=storage

# -------------------- 业务阈值（上线关键：务必显式设置）--------------------
# FAQ 挖掘推荐触发频次
FAQ_MIN_FREQUENCY=50
# 召回相似度阈值：实测 text-embedding-v4 + COSINE 真实命中约 0.73~0.79，
# 默认 0.8 会把真实命中全部误杀，导致"召回为空"。生产必须设为 0.7 左右。
RECALL_SIMILARITY_THRESHOLD=0.7

# -------------------- 数据权限 --------------------
# 部门树上下级继承（true/false）
DEPT_PERMISSION_INHERIT=true
# 天然绕过数据权限校验的角色编码（逗号分隔）
ADMIN_ROLE_CODES=sys_admin,kb_admin

# -------------------- 多轮会话 --------------------
# 保留的上下文轮数
CONVERSATION_CONTEXT_ROUNDS=10

# -------------------- 登录限流（P1 安全加固）--------------------
# 同一用户名 / 同一 IP 在窗口内的失败上限，超过返回 429
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_WINDOW_SECONDS=300

# -------------------- 种子数据（可选，scripts/seed_data.py 用）--------------------
# 演示账号口令；上线前必须删除演示账号或改强口令
KB_DEMO_PASSWORD=<CHANGE-ME>
